layout {
	default_tab_template {
		children
		pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
	}

	tab name="nvim" cwd="~/code/et3allim" borderless=true {
		pane borderless=true edit="./"
	}

	tab name="run" cwd="~/code/et3allim" split_direction="vertical" {
		pane cwd="client" command="npm" borderless=false {
			args "run" "dev"
		}
		pane cwd="server/api" command="dotnet" borderless=false {
			args "watch"
		}
	}

}
