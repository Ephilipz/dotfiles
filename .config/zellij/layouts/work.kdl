layout {
	default_tab_template {
		children
		pane size=1 borderless=true {
			plugin location="zellij:compact-bar"
		}
	}

	tab name="nvim" cwd="~/work/chatbase/" split_direction="vertical" {
		pane borderless=true edit="./"

		pane split_direction="horizontal" {
			pane command="npm" {
				args "run" "dev"
			}
			pane command="git" {
				args "status"
			}
		}

	}
}
